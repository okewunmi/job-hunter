GOOGLE_API_KEY=

# ─── Groq (FREE fallback — Llama 3.3 70B) ────────────────────────────────
# Get at: https://console.groq.com
GROQ_API_KEY=

# ─── Adzuna Job Board (FREE — 250 calls/day) ──────────────────────────────
# Sign up at: https://developer.adzuna.com
ADZUNA_APP_ID=your-app-id
ADZUNA_APP_KEY=your-app-key

# ─── Resend Email ──────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=okewunmiafeezolaide@gmail.com
NOTIFICATION_EMAIL=okewunmiafeezolaide@gmail.com

# ─── App ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=any-random-string-here

# ─── Profile (set after first onboarding) ─────────────────────────────────
PROFILE_ID=your-profile-uuid
